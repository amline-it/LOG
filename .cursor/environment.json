{
  "name": "Amline LOG Monitoring",
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "ports": [
    { "name": "dashboard", "port": 43123 }
  ],
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev -- --hostname 0.0.0.0 --port 43123",
      "description": "Next.js dev server on :43123"
    }
  ]
}
